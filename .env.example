# Configuración General del Servidor
NODE_ENV=development
PORT=3010

# Base de Datos MongoDB (Monolito Unificado)
MONGO_URI=mongodb://127.0.0.1:27017/bd_geopet   

# JWT Autenticación
JWT_SECRET=tu_clave_secreta_jwt_segura_aqui
JWT_EXPIRES_IN=24h

# Cloudinary (Almacenamiento de fotos: perfiles, mascotas, publicaciones)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Twilio (SMS / Restablecimiento de contraseña)
TWILIO_ACCOUNT_SID=tu_twilio_account_sid
TWILIO_AUTH_TOKEN=tu_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
