{
  "name": "geopet-server",
  "version": "1.0.0",
  "description": "Backend Monolítico Modular y API REST para GeoPet",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/api_gateway-service/",
      "/autentication-service/",
      "/pets-service/",
      "/posts-service/",
      "/users-service/"
    ]
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "modular-monolith",
    "geopet",
    "lost-pets",
    "geopet-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "password-validator": "^5.3.0",
    "twilio": "^5.1.1",
    "udv-ec": "^1.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
